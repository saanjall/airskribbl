# Optional. Without a key the end-of-round comments use built-in lines.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Port for `npm start`. Hosting platforms usually set this for you.
# PORT=3001

# Only needed if the client is served from a different origin than the server.
# CLIENT_ORIGIN=https://your-site.example
